EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used only by scripts/seed.js. Never expose in the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta Muse (server-side only)
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
AI_PROVIDER=muse

# Nest API (server/index.mts). Optional: auto-detected from the Expo dev host. Set only to override (e.g. tunnel mode).
# EXPO_PUBLIC_NEST_API_URL=http://localhost:8787

# Ingestion: timer interval in minutes (0 disables). Optional shared secret for POST /api/ingest webhooks/cron.
INGEST_INTERVAL_MIN=5
INGEST_SECRET=
