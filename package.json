{
  "name": "facebook-mobile-clone",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan --clear --port 8081",
    "start:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-tunnel.ps1",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "seed": "node --env-file=.env scripts/seed.js",
    "seed:preview": "node --env-file=.env scripts/expand-mock-data.cjs",
    "seed:expand": "node --env-file=.env scripts/expand-mock-data.cjs --apply",
    "db:inventory": "node --env-file=.env scripts/mock-db-inventory.cjs",
    "test:corpus": "node --test scripts/data/nest-corpus.test.cjs",
    "test:nest": "node --test src/nest/matching.test.mjs",
    "capture:nest": "node scripts/nest-capture.cjs",
    "ingest": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ingest.mts",
    "server": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mts",
    "dump-posts": "node scripts/dump-posts.cjs",
    "demo:post": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/demo-post.mts",
    "dev": "node scripts/dev.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.109.0",
    "expo": "~58.0.0",
    "expo-font": "~58.0.12",
    "expo-status-bar": "~58.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-web": "^0.x21.4",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.65.0",
    "@types/react": "~19.3.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
