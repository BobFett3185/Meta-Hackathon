{
  "name": "facebook-mobile-clone",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan --clear --port 8081",
    "start:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-tunnel.ps1",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "seed": "node --env-file=.env scripts/seed.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@supabase/supabase-js": "^2.109.0",
    "expo": "~58.0.0",
    "expo-font": "~58.0.12",
    "expo-status-bar": "~58.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-web": "^0.21.4",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3"
  },
  "private": true
}
